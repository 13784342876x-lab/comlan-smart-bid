{
  "schema_version": "2.0",
  "default_profile": "ark_draft",
  "role_bindings": {
    "drafting": "ark_draft",
    "review": "ark_review",
    "fast_task": "ark_fast",
    "web_search": "ark_web_search"
  },
  "profiles": {
    "deepseek_draft": {
      "provider": "openai_compatible",
      "protocol": "openai_compatible",
      "api_style": "chat_completions",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "model": "deepseek-v4-pro",
      "structured_output_mode": "prompt_json",
      "stream": true,
      "timeout_seconds": 300,
      "max_retries": 2,
      "max_output_tokens": 16000,
      "temperature": 0.2,
      "enabled": true,
      "send_temperature": true,
      "send_max_output_tokens": true,
      "send_thinking": true,
      "send_metadata": false,
      "capabilities": {
        "supports_tools": true,
        "supports_parallel_tool_calls": true,
        "supports_streaming": true,
        "supports_structured_output": true,
        "supports_reasoning_content": true,
        "requires_reasoning_content_replay": true,
        "supports_developer_role": false,
        "supports_tool_choice": false,
        "supports_tool_choice_none": false,
        "supports_usage_in_stream": true
      },
      "request_mapping": {
        "system_role": "system",
        "token_limit_parameter": "max_tokens",
        "finalization_strategy": "omit_tools",
        "thinking_configuration": {
          "enabled": true,
          "reasoning_effort": "high"
        }
      },
      "extra_body": {
        "thinking": {
          "type": "enabled"
        }
      },
      "extra_headers": {}
    },
    "deepseek_fast": {
      "provider": "openai_compatible",
      "protocol": "openai_compatible",
