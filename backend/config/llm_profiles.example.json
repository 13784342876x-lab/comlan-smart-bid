      "timeout_seconds": 180,
      "max_retries": 2,
      "max_output_tokens": 8000,
      "temperature": 0.1,
      "enabled": true,
      "send_temperature": true,
      "send_max_output_tokens": true,
      "send_thinking": false,
      "send_metadata": false,
      "capabilities": {
        "supports_tools": true,
        "supports_parallel_tool_calls": true,
