{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technical_fulltext_stage13_handoff_v1.json",
  "title": "Stage13 Revision Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_identity", "source_lineage", "finalization_ref",
    "revision_candidates", "approved_facts", "approved_material_refs",
    "prohibited_inferences", "accepted_risk_items", "summary",
    "pre_stage13_dependencies", "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "technical_fulltext_stage13_handoff_v1" },
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "document_id", "output_key", "status"],
      "properties": {
        "handoff_id": { "type": "string", "pattern": "^S13H-[A-F0-9]{16}$" },
        "document_id": { "type": "string", "minLength": 1 },
        "output_key": { "type": "string", "minLength": 1 },
        "status": { "const": "ready" }
      }
    },
    "source_lineage": { "type": "object" },
    "finalization_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finalization_id", "path"],
      "properties": {
        "finalization_id": { "type": "string", "pattern": "^THF-" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "revision_candidates": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "approved_facts": { "type": "array", "items": { "type": "object" } },
    "approved_material_refs": { "type": "array", "items": { "type": "object" } },
    "prohibited_inferences": { "type": "array", "items": { "type": "object" } },
    "accepted_risk_items": { "type": "array", "items": { "type": "object" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_candidate_count", "release_blocking_candidate_count", "accepted_risk_count"],
      "properties": {
        "revision_candidate_count": { "type": "integer", "minimum": 1 },
        "release_blocking_candidate_count": { "type": "integer", "minimum": 0 },
        "accepted_risk_count": { "type": "integer", "minimum": 0 }
      }
    },
    "pre_stage13_dependencies": { "type": "array", "items": { "type": "object" } },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
