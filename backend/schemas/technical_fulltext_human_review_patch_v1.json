{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technical_fulltext_human_review_patch_v1.json",
  "title": "Stage12-B Structured Human Review Patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "human_review_id", "base_human_review_sha256",
    "review_package_id", "review_package_sha256", "audited_content_sha256",
    "issue_decisions", "fact_confirmations", "material_verifications", "risk_acceptances"
  ],
  "properties": {
    "schema_version": { "const": "technical_fulltext_human_review_patch_v1" },
    "human_review_id": { "type": "string", "pattern": "^THR-[A-F0-9]{16}$" },
    "base_human_review_sha256": { "$ref": "#/$defs/sha256" },
    "review_package_id": { "type": "string", "pattern": "^TRP-[A-F0-9]{16}$" },
    "review_package_sha256": { "$ref": "#/$defs/sha256" },
    "audited_content_sha256": { "$ref": "#/$defs/sha256" },
    "issue_decisions": { "type": "array", "items": { "$ref": "#/$defs/issueUpdate" } },
    "fact_confirmations": { "type": "array", "items": { "$ref": "#/$defs/factUpdate" } },
    "material_verifications": { "type": "array", "items": { "$ref": "#/$defs/materialUpdate" } },
    "risk_acceptances": { "type": "array", "items": { "$ref": "#/$defs/riskUpdate" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableString": { "type": ["string", "null"] },
    "changeReason": { "type": "string", "minLength": 1 },
    "locationOverride": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "chapter_id": { "type": "string", "minLength": 1 },
        "section_id": { "type": "string", "minLength": 1 },
        "paragraph_id": { "type": "string", "minLength": 1 },
        "location_note": { "type": "string", "minLength": 1 }
      }
    },
    "issueUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id"],
      "properties": {
        "source_type": { "enum": ["FAI", "FSF"] },
        "source_id": { "type": "string", "pattern": "^(FAI|FSF)-" },
        "decision": { "enum": ["pending", "accepted", "rejected", "modified"] },
        "rejection_reason": { "$ref": "#/$defs/nullableString" },
        "revision_instruction": { "$ref": "#/$defs/nullableString" },
        "optional_comment": { "$ref": "#/$defs/nullableString" },
        "use_machine_location": { "type": "boolean" },
        "location_override": { "anyOf": [{ "$ref": "#/$defs/locationOverride" }, { "type": "null" }] },
        "location_override_reason": { "$ref": "#/$defs/nullableString" },
        "risk_acceptance_ref": { "type": ["string", "null"], "pattern": "^HRA-[A-F0-9]{16}$" },
        "change_reason": { "$ref": "#/$defs/changeReason" }
      }
    },
    "factUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id"],
      "properties": {
        "source_type": { "enum": ["FCA", "FACT"] },
        "source_id": { "type": "string", "pattern": "^(FCA|FACT)-" },
        "confirmation_status": { "enum": ["pending", "confirmed", "rejected"] },
        "confirmed_value": {},
        "source_description": { "$ref": "#/$defs/nullableString" },
        "confirmation_basis": { "type": ["string", "null"], "enum": [null, "human_provided", "document_verified", "explicitly_confirmed"] },
        "confirmation_note": { "$ref": "#/$defs/nullableString" },
        "rejection_reason": { "$ref": "#/$defs/nullableString" },
        "change_reason": { "$ref": "#/$defs/changeReason" }
      }
    },
    "materialUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "material_or_evidence_ref"],
      "properties": {
        "source_type": { "enum": ["EVIDENCE_QUERY", "EVIDENCE"] },
        "material_or_evidence_ref": { "type": "string", "minLength": 1 },
        "verification_status": { "enum": ["pending", "verified", "invalid", "expired", "not_provided"] },
        "material_name": { "$ref": "#/$defs/nullableString" },
        "subject_match": { "type": ["boolean", "null"] },
        "validity_date": { "$ref": "#/$defs/nullableString" },
        "verification_note": { "$ref": "#/$defs/nullableString" },
        "candidate_reference": { "$ref": "#/$defs/nullableString" },
        "file_reference": { "$ref": "#/$defs/nullableString" },
        "change_reason": { "$ref": "#/$defs/changeReason" }
      }
    },
    "riskUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "accepted", "scope"],
      "properties": {
        "risk_acceptance_id": { "type": "string", "pattern": "^HRA-[A-F0-9]{16}$" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "accepted": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/nullableString" },
        "scope": { "type": "string", "minLength": 1 },
        "change_reason": { "$ref": "#/$defs/changeReason" }
      }
    }
  }
}
