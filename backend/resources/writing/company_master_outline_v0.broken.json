{
  "schema_version": "company_technical_writing_outline_v0",
  "outline_id": "COMPANY-TECHNICAL-OUTLINE-V0",
  "name": "公司技术标通用写作大纲V0",
  "scope": "technical_only",
  "status": "testing",
  "description": "当招标文件未规定完整技术文件结构时，作为默认写作骨架；当招标文件规定部分或全部格式时，作为内容模块映射来源。",
  "adaptation_policy": {
    "priority": [
      "tender_mandatory_format",
      "tender_scoring_items",
      "tender_technical_requirements",
      "company_master_outline"
    ],
    "format_modes": {
      "none": {
        "description": "招标文件未给定技术文件目录或格式",
        "action": "使用公司通用大纲作为外层结构，并按评分项和响应要求增删子章节"
      },
      "forms_only": {
        "description": "招标文件只给定点对点应答表、偏差表、人员表等专项表格",
        "action": "使用公司通用大纲作为正文结构，并在规定位置插入招标文件要求的表格"
      },
      "partial_outline": {
        "description": "招标文件规定部分技术章节，但没有形成完整目录",
        "action": "保留招标规定章节，使用公司通用模块补齐其他必要章节"
      },
      "full_outline": {
        "description": "招标文件明确规定完整章节、顺序或目录",
        "action": "以招标目录作为唯一外层结构，将公司通用模块映射、拆分或合并到规定位置"
      }
    },
    "mapping_types": [
      "direct",
      "renamed",
      "merged",
      "split",
      "inserted",
      "form_only"
    ],
    "rules": [
      "不得改变招标文件强制要求的章节顺序",
      "不得删除有评分项或强制响应点支撑的章节",
      "公司通用章节与招标章节含义相同但名称不同时，采用招标章节名称",
      "一个公司模块可以拆分到多个招标章节",
      "多个公司模块可以合并进入一个招标章节",
      "没有招标依据、评分依据或完整性价值的可选章节可以不生成",
      "点对点应答表和技术偏差表不得被普通叙述章节替代",
      "企业事实、人员、业绩、品牌和参数必须来自确认事实或本地知识库"
    ]
  },
